##
# Shared Library Build Rules for StanRun
##

# Shared library specific compiler flags
SHARED_CXXFLAGS = $(CXXFLAGS) -fPIC -fvisibility=hidden -fvisibility-inlines-hidden
SHARED_CPPFLAGS = $(CPPFLAGS) -DSTANRUN_BUILDING_LIBRARY

# StanRun C API source files
STANRUN_API_SOURCES = src/stan/run/stanrun_c_api.cpp
STANRUN_API_O = src/stan/run/stanrun_c_api.o

# Don't remove intermediate files
.PRECIOUS: %.o %.hpp %_model.so %_model_shared.o

##
# Stan model compilation chain (adapted from make/program)
##

# Enable OpenCL support if requested
ifdef STAN_OPENCL
STANCFLAGS+= --use-opencl
endif

# Handle --allow-undefined flag for USER_HEADER
ifneq ($(findstring allow-undefined,$(STANCFLAGS)),)
USER_HEADER ?= $(dir $@)user_header.hpp

$(USER_HEADER):
	@echo 'ERROR: Missing user header.'
	@echo 'Because --allow-undefined is set, we need a C++ header file to include.'
	@echo 'We tried to find the user header at:'
	@echo '  $(USER_HEADER)'
	@echo ''
	@echo 'You can also set the USER_HEADER variable to the path of your C++ file.'
	@exit 1
endif

# Stan to C++ translation (same as make/program)
%.hpp : %.stan bin/stanc$(EXE)
	@echo ''
	@echo '--- Translating Stan model to C++ code ---'
	$(WINE) bin/stanc$(EXE) $(STANCFLAGS) --o=$(subst  \,/,$@) $(subst  \,/,$<)

# Dependency files for .hpp
%.d: %.hpp

##
# Compile StanRun C API with shared library flags
##
src/stan/run/stanrun_c_api.o : src/stan/run/stanrun_c_api.cpp
	@echo ''
	@echo '--- Compiling StanRun C API for shared library ---'
	@mkdir -p $(dir $@)
	$(CXX) $(SHARED_CPPFLAGS) $(SHARED_CXXFLAGS) $(INC_FIRST) $(INC) \
		-MMD -MP -MT $@ -MF src/stan/run/stanrun_c_api.d -c $< -o $@

##
# Compile model objects with shared library flags
##
%_model_shared.o : %.hpp $(USER_HEADER)
	@echo ''
	@echo '--- Compiling model for shared library: $< ---'
	@mkdir -p $(dir $@)
	$(CXX) $(SHARED_CPPFLAGS) $(SHARED_CXXFLAGS) $(INC_FIRST) $(INC) \
		-x c++ -c $< -o $@

##
# Link model-specific shared libraries
##
%_model.so : %_model_shared.o $(STANRUN_API_O) $(SUNDIALS_TARGETS) $(MPI_TARGETS) $(TBB_TARGETS)
	@echo ''
	@echo '--- Linking model shared library: $@ ---'
	@echo '  Model object: $<'
	@echo '  StanRun API: $(STANRUN_API_O)'
	$(CXX) -shared $(LDFLAGS) -o $@ $< $(STANRUN_API_O) \
		$(LDLIBS) $(SUNDIALS_TARGETS) $(MPI_TARGETS) $(TBB_TARGETS) -lm

##
# Handle precompiled headers for clang
##
ifneq ($(PRECOMPILED_MODEL_HEADER),)
$(patsubst %.hpp.gch,%.d,$(PRECOMPILED_MODEL_HEADER)) : DEPTARGETS = -MT $(PRECOMPILED_MODEL_HEADER)
$(patsubst %.hpp.gch,%.d,$(PRECOMPILED_MODEL_HEADER)) : DEPFLAGS_OS = -M -E
$(patsubst %.hpp.gch,%.d,$(PRECOMPILED_MODEL_HEADER)) : $(STAN)src/stan/model/model_header.hpp
	@mkdir -p $(dir $@)
	$(COMPILE.cpp) $(DEPFLAGS) $<

$(PRECOMPILED_MODEL_HEADER) : $(STAN)src/stan/model/model_header.hpp
	@echo ''
	@echo '--- Compiling pre-compiled header. This might take a few seconds. ---'
	@mkdir -p $(dir $@)
	$(COMPILE.cpp) $< $(OUTPUT_OPTION)

ifeq ($(CXX_TYPE),clang)
SHARED_CXXFLAGS += -include-pch $(PRECOMPILED_MODEL_HEADER)
$(STANRUN_API_O) : $(PRECOMPILED_MODEL_HEADER)
%_model_shared.o : $(PRECOMPILED_MODEL_HEADER)
endif
endif

##
# Dependency handling
##
src/stan/run/stanrun_c_api.d : src/stan/run/stanrun_c_api.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(SHARED_CPPFLAGS) $(SHARED_CXXFLAGS) $(INC_FIRST) $(INC) \
		-MMD -MP -MT src/stan/run/stanrun_c_api.o -MF $@ -c $< -o /dev/null

# Keep shared library objects if requested
ifeq ($(KEEP_OBJECT), true)
.PRECIOUS: %_model_shared.o $(STANRUN_API_O)
endif

# Include dependency files
-include src/stan/run/stanrun_c_api.d
-include $(wildcard *_model_shared.d)
ifneq (,$(PRECOMPILED_MODEL_HEADER))
-include $(patsubst %.hpp.gch,%.d,$(PRECOMPILED_MODEL_HEADER))
endif

##
# Convenience targets
##
.PHONY: shared-lib-help
shared-lib-help:
	@echo 'Shared Library Targets:'
	@echo '  modelname_model.so    : Build shared library for modelname.stan'
	@echo '  build-stanrun-api     : Build just the StanRun C API object'
	@echo '  clean-shared          : Clean shared library build artifacts'
	@echo ''
	@echo 'Build process:'
	@echo '  1. modelname.stan -> modelname.hpp (via stanc compiler)'
	@echo '  2. modelname.hpp -> modelname_model_shared.o (with -fPIC)'
	@echo '  3. stanrun_c_api.cpp -> stanrun_c_api.o (with -fPIC)'
	@echo '  4. Link: modelname_model_shared.o + stanrun_c_api.o + libraries -> modelname_model.so'
	@echo ''
	@echo 'Examples:'
	@echo '  make bernoulli_model.so'
	@echo '  make src/test/test-models/good/bernoulli_model.so'

.PHONY: build-stanrun-api
build-stanrun-api: $(STANRUN_API_O)

##
# Debug targets
##
.PHONY: show-shared-vars
show-shared-vars:
	@echo 'STANRUN_API_SOURCES: $(STANRUN_API_SOURCES)'
	@echo 'STANRUN_API_O: $(STANRUN_API_O)'
	@echo 'SHARED_CXXFLAGS: $(SHARED_CXXFLAGS)'
	@echo 'SHARED_CPPFLAGS: $(SHARED_CPPFLAGS)'
	@echo 'SUNDIALS_TARGETS: $(SUNDIALS_TARGETS)'
	@echo 'MPI_TARGETS: $(MPI_TARGETS)'
	@echo 'TBB_TARGETS: $(TBB_TARGETS)'
	@echo 'PRECOMPILED_MODEL_HEADER: $(PRECOMPILED_MODEL_HEADER)'

.PHONY: test-shared-deps
test-shared-deps:
	@echo 'For bernoulli_model.so, build chain:'
	@echo '  1. bernoulli.stan -> bernoulli.hpp (stanc)'
	@echo '  2. bernoulli.hpp -> bernoulli_model_shared.o'
	@echo '  3. stanrun_c_api.cpp -> stanrun_c_api.o'
	@echo '  4. Link: bernoulli_model_shared.o + stanrun_c_api.o -> bernoulli_model.so'

##
# Clean targets
##
.PHONY: clean-shared
clean-shared:
	@echo '  removing shared library objects and libraries'
	$(RM) $(STANRUN_API_O)
	$(RM) src/stan/run/stanrun_c_api.d
	$(RM) $(wildcard *_model_shared.o)
	$(RM) $(wildcard *_model_shared.d)
	$(RM) $(wildcard *_model.so)
	$(RM) $(call findfiles,src/test/test-models,*_model_shared.o)
	$(RM) $(call findfiles,src/test/test-models,*_model_shared.d)
	$(RM) $(call findfiles,src/test/test-models,*_model.so)
	$(RM) $(call findfiles,.,*_model.so)

##
# Test targets
##
.PHONY: test-bernoulli-shared
test-bernoulli-shared: src/test/test-models/good/bernoulli_model.so
